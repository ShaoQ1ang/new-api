FROM m.daocloud.io/docker.io/library/golang:1.26.4-alpine AS builder
ARG GOPROXY=https://goproxy.cn,direct
ARG GOSUMDB=sum.golang.google.cn
ENV CGO_ENABLED=0 GOEXPERIMENT=greenteagc GOPROXY=${GOPROXY} GOSUMDB=${GOSUMDB}
ARG TARGETOS
ARG TARGETARCH
ENV GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64}
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -trimpath -ldflags "-s -w" -o /out/new-api-control ./cmd/new-api-control

FROM m.daocloud.io/docker.io/library/debian@sha256:f06537653ac770703bc45b4b113475bd402f451e85223f0f2837acbf89ab020a
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && update-ca-certificates
COPY --from=builder /out/new-api-control /new-api-control
COPY LICENSE NOTICE THIRD-PARTY-LICENSES.md /licenses/
RUN mkdir -p /data/logs && chown -R 65532:65532 /data
USER 65532:65532
EXPOSE 3010
WORKDIR /data
ENTRYPOINT ["/new-api-control"]
