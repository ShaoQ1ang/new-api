ARG GO_IMAGE=golang:1.26.1
ARG RUNTIME_IMAGE=debian:bookworm-slim
ARG APT_MIRROR=https://mirrors.aliyun.com

FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS builder
ENV CGO_ENABLED=0 GOEXPERIMENT=greenteagc
ARG TARGETOS
ARG TARGETARCH
ARG GOPROXY=https://proxy.golang.org,direct
ARG GOSUMDB=sum.golang.org
ENV GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64}
ENV GOPROXY=${GOPROXY} GOSUMDB=${GOSUMDB}
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -trimpath -ldflags "-s -w" -o /out/new-api-control ./cmd/new-api-control

FROM ${RUNTIME_IMAGE}
ARG APT_MIRROR
RUN sed -i "s@https\?://deb.debian.org@${APT_MIRROR}@g; s@https\?://security.debian.org@${APT_MIRROR}@g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && update-ca-certificates
COPY --from=builder /out/new-api-control /new-api-control
COPY LICENSE NOTICE THIRD-PARTY-LICENSES.md /licenses/
RUN mkdir -p /data/logs && chown -R 65532:65532 /data
USER 65532:65532
EXPOSE 3010
WORKDIR /data
ENTRYPOINT ["/new-api-control"]
